{
  "id": "s07_text_duplicate_booking_trap",
  "modality": "text",
  "title": "Duplicate-booking trap",
  "description": "The booking is slow. The user nudges twice and repeats the request. The agent must report progress and never issue (or cancel and reissue) a second book_flight.",
  "duration_ms": 20000,
  "session": {
    "reference_date": "2026-09-29",
    "locale": "en-IN",
    "timezone": "Asia/Kolkata"
  },
  "tools": {
    "enabled": [
      "flight_search",
      "book_flight"
    ],
    "config": {
      "book_flight": {
        "latency_ms": 900,
        "faults": [
          {
            "call_index": 1,
            "kind": "slow",
            "latency_ms": 6000
          }
        ],
        "fixtures": [
          {
            "match": {
              "flight_id": "AI-202"
            },
            "response": {
              "booking_ref": "RV4T9N",
              "flight_id": "AI-202",
              "status": "confirmed"
            }
          }
        ]
      }
    }
  },
  "events": [
    {
      "id": "e1",
      "t_ms": 0,
      "type": "text_chunk",
      "text": "Book flight AI-202 for Rahul Verma.",
      "end_of_turn": true
    },
    {
      "id": "e2",
      "t_ms": 2500,
      "type": "text_chunk",
      "text": "Hello? Did that go through? Please book AI-202 for Rahul Verma.",
      "end_of_turn": true
    },
    {
      "id": "e3",
      "t_ms": 4500,
      "type": "text_chunk",
      "text": "Just book it now please.",
      "end_of_turn": true
    }
  ],
  "expected": {
    "required_calls": [
      {
        "tool": "book_flight",
        "args": {
          "flight_id": "AI-202",
          "passenger_name": "Rahul Verma"
        },
        "max_count": 1
      }
    ],
    "forbidden_calls": [
      {
        "tool": "book_flight",
        "after_event": "e2"
      }
    ],
    "must_cancel": [],
    "max_writes": {
      "book_flight": 1
    },
    "final_snapshot": {
      "intent": {
        "any_of": [
          "book_flight",
          "flight_booking"
        ]
      },
      "slots": {
        "flight_id": "AI-202",
        "passenger_name": "Rahul Verma",
        "booking_ref": "RV4T9N"
      }
    },
    "final_mentions": [
      {
        "any_of": [
          "RV4T9N"
        ]
      }
    ]
  }
}
